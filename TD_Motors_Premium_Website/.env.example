# Copy this file to .env and set real values before deployment.
SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=development
FLASK_DEBUG=0
# SQLite is fine for local development. For deployment, use managed PostgreSQL:
# DATABASE_URL=postgresql://username:password@host:5432/database
# Redis is recommended for shared rate limits in multi-worker production:
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# Optional SMTP configuration for email notifications (not enabled until configured in app):
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=info.technodriven@gmail.com
MAIL_PASSWORD=use-an-app-password-not-your-email-password
MAIL_DEFAULT_SENDER=info.technodriven@gmail.com

# Optional SMS OTP password recovery (Twilio Verify)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
